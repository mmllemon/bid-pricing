*.jpeg   binary
*.gif    binary
*.webp   binary
*.bmp    binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.otf    binary
*.ttf    binary
*.pdf    binary
*.xlsx   binary
*.xls    binary
*.db     binary
*.sqlite binary
*.sqlite-wal binary
